{
  "id": "dev.corral.Corral",
  "runtime": "org.gnome.Platform",
  "runtime-version": "50",
  "sdk": "org.gnome.Sdk",
  "command": "corral",
  "appstream-compose": false,
  "finish-args": [
    "--share=ipc",
    "--share=network",
    "--socket=fallback-x11",
    "--socket=wayland",
    "--device=dri"
  ],
  "cleanup": [
    "/include",
    "/lib/pkgconfig",
    "/man",
    "/share/doc",
    "/share/gtk-doc",
    "/share/man",
    "/share/pkgconfig",
    "/lib/zig-toolchain",
    "/bin/zig",
    "*.la",
    "*.a"
  ],
  "modules": [
    {
      "name": "zig-x86_64",
      "buildsystem": "simple",
      "only-arches": ["x86_64"],
      "build-commands": [
        "mkdir -p /app/bin /app/lib/zig-toolchain",
        "cp -a . /app/lib/zig-toolchain/",
        "ln -s /app/lib/zig-toolchain/zig /app/bin/zig"
      ],
      "sources": [
        {
          "type": "archive",
          "url": "https://ziglang.org/download/0.17.0/zig-x86_64-linux-0.17.0.tar.xz",
          "sha256": "1cbe9df9f27e6b78d14ccbca43b6703a404ef79ef1c463de901d7f088d4e2026"
        }
      ]
    },
    {
      "name": "zig-aarch64",
      "buildsystem": "simple",
      "only-arches": ["aarch64"],
      "build-commands": [
        "mkdir -p /app/bin /app/lib/zig-toolchain",
        "cp -a . /app/lib/zig-toolchain/",
        "ln -s /app/lib/zig-toolchain/zig /app/bin/zig"
      ],
      "sources": [
        {
          "type": "archive",
          "url": "https://ziglang.org/download/0.17.0/zig-aarch64-linux-0.17.0.tar.xz",
          "sha256": "9e8d11661d4ae3bd57702a3832781e23ad151dde5798e16a5ccd503f65234ff8"
        }
      ]
    },
    {
      "name": "corral",
      "buildsystem": "meson",
      "config-opts": [
        "-Dbuildtype=release"
      ],
      "build-options": {
        "build-args": [
          "--share=network"
        ],
        "env": {
          "ZIG": "/app/bin/zig",
          "ZIG_GLOBAL_CACHE_DIR": "/run/build/corral/third_party/zig-cache"
        }
      },
      "sources": [
        {
          "type": "dir",
          "path": "../..",
          "skip": [
            ".git",
            "build",
            "build-pkg",
            "third_party/ghostty/.git",
            "third_party/ghostty/.zig-cache",
            "third_party/ghostty/zig-out",
            "third_party/zig-linux",
            "packaging/arch/pkg",
            "packaging/arch/src",
            "packaging/appimage/AppDir",
            "packaging/appimage/builddir",
            "packaging/flatpak/build-dir",
            "packaging/flatpak/repo"
          ]
        }
      ]
    }
  ]
}
