+    /// Drop GPU resources when the host display is going away.
+    /// Does not free the surface.
+    export fn ghostty_surface_display_unrealized(surface: *Surface) void {
+        surface.core_surface.displayUnrealized();
+    }
+
+    const ExportedFrame = extern struct {
+        width: u32,
+        height: u32,
+        pixels: ?[*]u8,
+        len: usize,
+    };
+
+    /// Copy the latest CPU frame into `out`. DMABUF frames are dropped;
+    /// the embedder should report unhealthy presentation so the renderer
+    /// readbacks pixels instead. Returns false when no CPU frame is waiting.
+    export fn ghostty_surface_take_frame(surface: *Surface, out: *ExportedFrame) bool {
+        const frame = surface.core_surface.renderer.takeFrame() orelse return false;
+        switch (frame) {
+            .dmabuf => |buf| {
+                buf.deinit();
+                return false;
+            },
+            .memory => |mem| {
+                defer mem.deinit();
+                if (mem.pixels.len == 0) return false;
+                const raw = std.c.malloc(mem.pixels.len) orelse return false;
+                const copy: [*]u8 = @ptrCast(raw);
+                @memcpy(copy[0..mem.pixels.len], mem.pixels);
+                out.* = .{
+                    .width = mem.width,
+                    .height = mem.height,
+                    .pixels = copy,
+                    .len = mem.pixels.len,
+                };
+                return true;
+            },
+        }
+    }
+
+    export fn ghostty_surface_free_frame(frame: *ExportedFrame) void {
+        if (frame.pixels) |ptr| std.c.free(ptr);
+        frame.* = .{
+            .width = 0,
+            .height = 0,
+            .pixels = null,
+            .len = 0,
+        };
+    }
+
+    export fn ghostty_surface_report_renderer_health(surface: *Surface, health_raw: c_int) void {
+        const health = std.enums.fromInt(renderer.Health, health_raw) orelse return;
+        surface.core_surface.reportPresentationHealth(health);
+    }
